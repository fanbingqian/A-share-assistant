# ============================================================
# 运行数据：含 API Key、个人持仓、日历、日志、新闻与行情缓存
# 绝不入库。唯一例外是程序内置的机构预测静态快照。
# ============================================================
/data/*
!/data/macro-expectations.json

# 构建产物与第三方依赖（成品通过 GitHub Releases 分发，不进 git）
/dist/
/node_modules/
/preview/
/.backup/
/.workbuddy/

# 临时文件、日志、自检产物
*.log
*.log.*
*.tmp
desktop-selftest.json
Thumbs.db
.DS_Store

# 本机计划任务定义快照：含本机账户 SID 与绝对路径，不入库
scripts/GlobalMarketMonitor-*.xml

# 本地凭据
.env
.env.*
